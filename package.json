{
  "name": "@arc-web/components",
  "description": "Web-components built on the ARC design system",
  "version": "2.1.2",
  "author": "JasperWieringa",
  "main": "dist/arc.js",
  "type": "module",
  "module": "dist/arc.js",
  "customElements": "custom-elements.json",
  "types": "dist/arc.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky install",
    "start": "tsc && concurrently -k -r \"yarn run analyze --watch\" \"tsc --watch --preserveWatchOutput\" \"wds\"",
    "build": "tsc && yarn run analyze --outdir dist && rollup -c rollup.config.js",
    "create": "plop --plopfile scripts/plop/plopfile.mjs",
    "test": "wtr --coverage",
    "test:watch": "concurrently -k -r \"tsc --watch --preserveWatchOutput\" \"wtr --watch\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "tsc && yarn run analyze && build-storybook",
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore && prettier \"**/*.ts\" --check --ignore-path .gitignore && stylelint \"**/*.css\" --ignore-path .gitignore",
    "format": "eslint --ext .ts,.html . --fix --ignore-path .gitignore && prettier \"**/*.ts\" --write --ignore-path .gitignore && stylelint \"**/*.css\" --fix --ignore-path .gitignore",
    "analyze": "cem analyze --litelement --exclude out-tsc --exclude dist",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.3",
    "date-fns": "^3.6.0",
    "lit": "^3.1.2",
    "tabbable": "^6.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.10",
    "@chromatic-com/storybook": "1.2.25",
    "@custom-elements-manifest/analyzer": "^0.9.4",
    "@open-wc/building-rollup": "^3.0.2",
    "@open-wc/dev-server-hmr": "^0.2.0",
    "@open-wc/eslint-config": "^12.0.3",
    "@open-wc/testing": "4.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@storybook/addon-essentials": "^8.0.4",
    "@storybook/addon-links": "^8.0.4",
    "@storybook/blocks": "^8.0.4",
    "@storybook/test": "^8.0.4",
    "@storybook/web-components": "^8.0.4",
    "@storybook/web-components-vite": "^8.0.4",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@web/test-runner": "^0.18.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-lit-a11y": "^4.1.2",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-wc": "^2.0.4",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "plop": "^4.0.1",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-terser": "^7.0.2",
    "sinon": "^17.0.1",
    "storybook": "^8.0.4",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "tslib": "^2.3.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.4"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
