{
  "name": "@arc-web/components",
  "description": "Web-components built on the ARC design system",
  "version": "2.1.2",
  "author": "JasperWieringa",
  "main": "dist/arc.js",
  "type": "module",
  "module": "dist/arc.js",
  "customElements": "custom-elements.json",
  "types": "dist/arc.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run analyze && storybook dev -p 6006",
    "build": "tsc",
    "create": "plop --plopfile scripts/plop/plopfile.mjs",
    "test": "wtr --coverage",
    "test:watch": "wtr --watch",
    "lint": "eslint --ext .ts --fix --ignore-path .gitignore",
    "format": "npm run lint && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "analyze": "cem analyze --litelement"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.3",
    "date-fns": "^3.6.0",
    "lit": "^3.1.2",
    "tabbable": "^6.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.6.1",
    "@custom-elements-manifest/analyzer": "^0.10.2",
    "@open-wc/eslint-config": "^12.0.3",
    "@open-wc/testing": "^4.0.0",
    "@remcovaes/web-test-runner-vite-plugin": "^1.2.1",
    "@storybook/addon-essentials": "^8.2.5",
    "@storybook/addon-links": "^8.2.5",
    "@storybook/blocks": "^8.2.5",
    "@storybook/builder-vite": "^8.2.5",
    "@storybook/preview-api": "^8.2.5",
    "@storybook/test": "^8.2.5",
    "@storybook/web-components": "^8.2.5",
    "@storybook/web-components-vite": "^8.2.5",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@web/test-runner": "^0.18.2",
    "@web/test-runner-playwright": "^0.11.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "plop": "^4.0.1",
    "prettier": "^3.3.2",
    "sinon": "^18.0.0",
    "storybook": "^8.2.5",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "auto"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
